generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum BillType {
  COMMERCIAL
  SMALL
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  invoices     Invoice[] @relation("InvoiceCreatedBy")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  // COMMERCIAL = the existing VAT/non-VAT dot-matrix tax invoice flow
  // (Gazette 2481/22 numbering). SMALL = the blank-paper "small bill"
  // flow (Jollymark printer, E-prefixed numbering, no VAT). Same model
  // for both so customer dedup, money math, and status tracking are
  // shared — see CLAUDE.md / the small-bill feature plan.
  billType       BillType      @default(COMMERCIAL)
  date           DateTime      @default(now())
  dateOfDelivery DateTime?
  placeOfSupply  String?
  modeOfPayment  String?
  additionalInfo String?
  status         InvoiceStatus @default(UNPAID)
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     String?
  taxEnabled     Boolean       @default(false)
  taxPercent     Float         @default(0)
  subtotal       Float
  taxAmount      Float
  total          Float
  items          InvoiceItem[]
  createdAt      DateTime      @default(now())
  createdBy      User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId String
  reference String?
  name      String
  price     Float
  quantity  Float
  lineTotal Float
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
}

model Product {
  id        String        @id @default(cuid())
  reference String        @unique
  name      String
  price     Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     InvoiceItem[]
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  createdAt DateTime  @default(now())
  invoices  Invoice[]
}

model BusinessSettings {
  id           String  @id @default("default")
  businessName String
  logoUrl      String?
  address      String?
  phone        String?
  whatsapp     String?
  email        String?
  taxId        String?
  defaultTax   Float   @default(0)

  // Invoice numbering (Gazette 2481/22): the "branch/unit/project" code
  // slotted into YYMMM_QQQQ_XXXXX. No settings UI edits this yet — it's set
  // via seed/direct DB update for now.
  invoiceUnitCode String @default("SST")

  // TEMPORARY (Aug 2026 backfill — see memory/temp_invoice_backfill_2026_08.md).
  // Null everywhere by default — deliberately opt-in per environment (only
  // ever set on production) rather than keyed off the system clock, so this
  // can never silently activate in local dev/test/CI just because the
  // calendar happens to read August 2026. Remove this column once the
  // client's backfill is done.
  tempInvoiceSerialFloorAugust2026 Int?

  // Dot-matrix pre-printed stationery print calibration
  dmOffsetXMm    Float @default(0)
  dmOffsetYMm    Float @default(0)
  dmFontSizePt   Float @default(10)
  dmItemRowMm    Float @default(6)
  // Multiplies every field's Y position (applied before dmOffsetYMm, from
  // the top of the page) — a plain offset can't correct a printer/driver
  // that compresses or stretches the page length proportionally (small
  // drift near the top, growing drift near the bottom), which a fixed mm
  // offset alone can't fix. Default 1 = no change; <1 compresses fields
  // upward, >1 spreads them further down. Tune by print-and-compare.
  dmScaleY       Float @default(1)
  // Same idea as dmScaleY, applied to X position (from the left edge) —
  // corrects a printer that pushes fields proportionally further right (or
  // left) the further they are from the left margin, which dmOffsetXMm's
  // flat shift can't fix on its own. Default 1 = no change.
  dmScaleX       Float @default(1)

  // Small-bill (Jollymark, 5.5in x 5.5in blank stock) print calibration —
  // a flat X/Y nudge only, not the full dm* scale/font/row system above:
  // that system exists because the dot-matrix print overlays fixed
  // coordinates onto pre-printed stationery; the small-bill print instead
  // flows a complete document from scratch onto blank paper, so only
  // page-registration drift needs correcting, not per-field position.
  smallBillOffsetXMm Float @default(0)
  smallBillOffsetYMm Float @default(0)
}
